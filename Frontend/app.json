{
  "expo": {
    "name": "LoreOfAmbition",
    "slug": "myexpoapp",
    "scheme": "myexpoapp",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-router"
    ],
    "orientation": "portrait",
